# PostgreSQL connection string (optional for local UI; required for db ping / migrate / seed)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aa_leave_tracker

# Required for `bun run db:seed` — IANA timezone. Seed fails if unset. Do not invent a US default.
# SEED_TIMEZONE=
# SEED_ADMIN_EMAIL=preston@absoluteaddiction.com
# SEED_SECOND_ADMIN_EMAIL=das@absoluteaddiction.com
# Or comma-separated: SEED_ADMIN_EMAILS=preston@absoluteaddiction.com,das@absoluteaddiction.com
# Required for seed — Better Auth password for seeded admins. Not committed.
# SEED_ADMIN_PASSWORD=

# Required at runtime (not for GET /api/health). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local only. Production must be https:// so session cookies stay Secure.
# BETTER_AUTH_URL=http://localhost:3000

# Optional leave.pending mail. Banner + send read these env vars.
# org_settings.email_enabled is a mirror of whether a key is set (not a kill switch).
# If both are unset, the column stays false and /admin shows: Email is off; check pending daily.
# RESEND_API_KEY=
# SMTP_URL=smtp://user:pass@localhost:587
# EMAIL_FROM=leave@absoluteaddiction.local

# Production privileged MFA gate (SEC-002). Ready returns 503 in production until set.
# PRIVILEGED_MFA=1

# Production login rate-limit store (SEC-003). File or DB flag required in production.
# LOGIN_RATE_LIMIT_FILE=/var/lib/aa-leave-tracker/login-rate-limit.json
# LOGIN_RATE_LIMIT_DB=1
